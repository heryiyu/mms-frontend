{
  "name": "nlc-mms-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sso": "vite -c vite.sso.config.ts",
    "build": "tsc -b && vite build && vite build -c vite.sso.config.ts",
    "build:sso": "tsc -b && vite build -c vite.sso.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:sso": "vite preview -c vite.sso.config.ts",
    "generate-pwa-assets": "pwa-assets-generator",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@logto/browser": "^3.1.0",
    "antd": "^6.6.5",
    "bootstrap-icons": "^1.13.1",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^3.0.2",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
